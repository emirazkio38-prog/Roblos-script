local snake = {}
local food = {x = 15, y = 10}
local dir = {x = 1, y = 0}
local nextDir = {x = 1, y = 0}
local sScore, sAlive, sTimer, sStep = 0, false, 0, 0.15

local function same(a, b)
    return a.x == b.x and a.y == b.y
end

local function placeFood()
    for _ = 1, 500 do
        local candidate = {x = math.random(1, GRID), y = math.random(1, GRID)}
        local occupied = false
        for _, part in ipairs(snake) do
            if same(part, candidate) then
                occupied = true
                break
            end
        end
        if not occupied then
            food = candidate
            return
        end
    end
end

local function renderSnake()
    for y = 1, GRID do
        for x = 1, GRID do
            cells[y][x].BackgroundColor3 = Color3.fromRGB(18, 43, 36)
        end
    end

    cells[food.y][food.x].BackgroundColor3 = Color3.fromRGB(255, 65, 75)

    for i, p in ipairs(snake) do
        cells[p.y][p.x].BackgroundColor3 = i == 1
            and Color3.fromRGB(160, 255, 120)
            or Color3.fromRGB(65, 210, 105)
    end
    sScoreLabel.Text = "SKOR: " .. sScore
end

local function resetSnake()
    snake = {{x = 7, y = 10}, {x = 6, y = 10}, {x = 5, y = 10}}
    dir = {x = 1, y = 0}
    nextDir = {x = 1, y = 0}
    sScore, sAlive, sTimer, sStep = 0, true, 0, 0.15
    sOver.Visible = false
    placeFood()
    renderSnake()
end

local function setDir(x, y)
    if currentGame ~= "snake" or hidden or not sAlive then return end
    if x == -dir.x and y == -dir.y then return end
    nextDir = {x = x, y = y}
end

