games[4]=function()
 local AR=1.6
 local WW=AR
 local f,L,R=field(AR)
 f.BackgroundColor3=Color3.fromRGB(8,10,26)
 local stars={}
 for i=1,34 do
  local s=obj("Frame",f,{Size=UDim2.fromOffset(2,2),BackgroundColor3=C.white,BackgroundTransparency=math.random()*.6,BorderSizePixel=0,ZIndex=11})
  stars[i]={f=s,x=math.random()*WW,y=math.random(),v=.05+math.random()*.25}
 end
 local sw,sh=.17,.13
 local ship=sprite(f,SP.ship,15)
 local sx=.05
 local sy=.5
 local lives,score,inv=3,0,0
 local fireT,spawnT,powerT=0,1,0
