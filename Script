 info.ZIndex=22
 local function updInfo()
  info.Text="VIDA "..lives..(powerT>0 and ("   TRIPLE "..math.ceil(powerT).."s") or "")
 end
 local function rect(ax,ay,aw,ah,bx,by,bw,bh) return ax<bx+bw and bx<ax+aw and ay<by+bh and by<ay+ah end

 local function fire()
  if fireT>0 or dead then return end
  fireT=.2
  local function mk(vy)
   local fr=obj("Frame",f,{BackgroundColor3=C.yellow,BorderSizePixel=0,ZIndex=14})
   round(fr,3)
   table.insert(bullets,{f=fr,x=sx+sw,y=sy,vy=vy})
