  modeBtn.BackgroundColor3=flagMode and C.red or C.blue
  sfx("tap")
 end,16)

 local function nb(x,y,fn)
  for dx=-1,1 do for dy=-1,1 do
   if dx~=0 or dy~=0 then
    local a,b=x+dx,y+dy
    if a>=1 and a<=COLS and b>=1 and b<=ROWS then fn(a,b) end
   end
  end end
 end
 local function placeMines(sx,sy)
  local n=0
  while n<MINES do
   local x,y=math.random(COLS),math.random(ROWS)
   if not mine[x][y] and not (math.abs(x-sx)<=1 and math.abs(y-sy)<=1) then
    mine[x][y]=true
    n+=1
   end
  end
  for x=1,COLS do for y=1,ROWS do
   local c=0
   nb(x,y,function(a,b) if mine[a][b] then c+=1 end end)
   cnt[x][y]=c
  end end
 end
 local function show(x,y)
  local b=cb[x][y]
  b.BackgroundColor3=Color3.fromRGB(22,30,52)
  local c=cnt[x][y]
  b.Text=c>0 and tostring(c) or ""
  if c>0 then b.TextColor3=numCols[c] end
 end
 local function reveal(x0,y0)
  local stack={{x0,y0}}
  local opened=0
  while #stack>0 do
   local c=table.remove(stack)
   local x,y=c[1],c[2]
   if not rev[x][y] and not flag[x][y] then
    rev[x][y]=true
    opened+=1
    revealed+=1
    show(x,y)
    if cnt[x][y]==0 then
     nb(x,y,function(a,b) if not rev[a][b] then table.insert(stack,{a,b}) end end)
    end
   end
  end
  return opened
 end
 local function tap(x,y)
  if over then return end
  if flagMode then
   if rev[x][y] then return end
   flag[x][y]=not flag[x][y]
   flags+=flag[x][y] and 1 or -1
   cb[x][y].Text=flag[x][y] and "🚩" or ""
   mineLbl.Text="BOM\n"..(MINES-flags)
   sfx("tap",flag[x][y] and 1.5 or 1)
   return
  end
  if flag[x][y] or rev[x][y] then return end
  if not placed then placeMines(x,y) placed=true end
  if mine[x][y] then
   over=true
   sfx("boom")
   for a=1,COLS do for b=1,ROWS do
    if mine[a][b] then
     cb[a][b].Text="💣"
     cb[a][b].BackgroundColor3=C.red
    end
   end end
   later(.9,function() finish("BOOM!") end)
   return
  end
  local n=reveal(x,y)
  sfx(n>1 and "pop" or "tap",n>1 and 1 or 1.2)
  score=revealed
  setScore(score)
  if revealed>=COLS*ROWS-MINES then
   over=true
   score+=50
   setScore(score)
   later(.5,function() finish("MENANG!",true) end)
  end
 end

 for x=1,COLS do for y=1,ROWS do
  local b=obj("TextButton",f,{
   Position=UDim2.new((x-1)/COLS,1,(y-1)/ROWS,1),Size=UDim2.new(1/COLS,-2,1/ROWS,-2),
