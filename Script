 local tiles={}
 local diff=2
 local diffNames={"MUDAH","SEDANG","SULIT"}
 local score,round_=0,0
 local playerTurn,busy=true,false
 local ended=false

 local function winner(b)
  for _,w in ipairs(WINS) do
   if b[w[1]]~="" and b[w[1]]==b[w[2]] and b[w[2]]==b[w[3]] then return b[w[1]],w end
  end
  for i=1,9 do if b[i]=="" then return nil end end
  return "D"
 end
 local function minimax(b,isO,depth)
  local w=winner(b)
  if w=="O" then return 10-depth elseif w=="X" then return depth-10 elseif w=="D" then return 0 end
  local best=isO and -math.huge or math.huge
  for i=1,9 do
   if b[i]=="" then
    b[i]=isO and "O" or "X"
    local s=minimax(b,not isO,depth+1)
    b[i]=""
    if isO then best=math.max(best,s) else best=math.min(best,s) end
   end
  end
  return best
 end
 local function aiPick()
  local empty={}
  for i=1,9 do if board[i]=="" then table.insert(empty,i) end end
  local smart=(diff==3) or (diff==2 and math.random()<.6)
  if not smart then return empty[math.random(#empty)] end
  local bestS,cands=-math.huge,{}
  for _,i in ipairs(empty) do
   board[i]="O"
   local s=minimax(board,false,1)
   board[i]=""
   if s>bestS then bestS=s cands={i} elseif s==bestS then table.insert(cands,i) end
  end
  return cands[math.random(#cands)]
 end

 local function refresh()
  for i=1,9 do
   tiles[i].Text=board[i]
   tiles[i].TextColor3=(board[i]=="X") and C.blue or C.red
