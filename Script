local function obj(class,parent,props)
 local o=Instance.new(class)
 for k,v in pairs(props or {}) do o[k]=v end
 o.Parent=parent
 return o
end
local function round(o,n) obj("UICorner",o,{CornerRadius=UDim.new(0,n or 8)}) end
local function stroke(o,color,th,tr)
 return obj("UIStroke",o,{Color=color,Thickness=th or 1.5,Transparency=tr or 0,ApplyStrokeMode=Enum.ApplyStrokeMode.Border})
end
local function put(o,WW,x,y,w,h)
 o.Position=UDim2.fromScale(x/WW,y)
 if w then o.Size=UDim2.fromScale(w/WW,h) end
end

