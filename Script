local ballStarted = false
local brickRows, brickCols = 5, 8

local brickColors = {
    Color3.fromRGB(255, 80, 90),
    Color3.fromRGB(255, 160, 65),
    Color3.fromRGB(255, 220, 70),
    Color3.fromRGB(70, 210, 120),
    Color3.fromRGB(75, 160, 255)
}

local function clearBricks()
    for _, brick in ipairs(bricks) do
        if brick.frame and brick.frame.Parent then brick.frame:Destroy() end
    end
    table.clear(bricks)
end

local function makeBricks()
    clearBricks()

    local gap = 4
    local areaWidth = playArea.AbsoluteSize.X
    local brickWidth = math.max(20, (areaWidth - gap * (brickCols + 1)) / brickCols)
    local brickHeight = math.max(12, math.min(20, playArea.AbsoluteSize.Y * 0.035))

    for row = 1, brickRows do
        for col = 1, brickCols do
            local brick = make("Frame", "Brick", playArea, {
                Position = UDim2.fromOffset(
                    gap + (col - 1) * (brickWidth + gap),
                    18 + (row - 1) * (brickHeight + gap)
                ),
                Size = UDim2.fromOffset(brickWidth, brickHeight),
                BackgroundColor3 = brickColors[row],
                BorderSizePixel = 0,
                ZIndex = 3
            })
            round(brick, 4)
            table.insert(bricks, {frame = brick, alive = true})
        end
    end
end

