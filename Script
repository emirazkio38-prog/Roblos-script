 for x=1,COLS do
  mine[x],rev[x],flag[x],cnt[x],cb[x]={}, {}, {}, {}, {}
  for y=1,ROWS do mine[x][y]=false rev[x][y]=false flag[x][y]=false cnt[x][y]=0 end
 end
 local numCols={C.blue,C.green,C.red,C.purple,C.orange,C.cyan,C.pink,C.white}
 local flagMode,placed,over=false,false,false
 local revealed,flags=0,0
 local score=0

 local mineLbl=txt(L,"BOM\n"..MINES,UDim2.new(0,0,.5,-40),UDim2.new(1,0,0,80),22,C.yellow)
 mineLbl.Font=Enum.Font.GothamBlack
