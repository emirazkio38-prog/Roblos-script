    brickGame.Visible = true
    back.Visible = true
    resetBrick()
end

flappyPick.Activated:Connect(startFlappy)
snakePick.Activated:Connect(startSnake)
brickPick.Activated:Connect(startBrick)
back.Activated:Connect(showMenu)

-- =====================================================
-- DRAGGABLE OPEN/CLOSE BUTTON
-- =====================================================

local dragging = false
local moved = false
local dragStart
local startPos

toggle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        moved = false
        dragStart = input.Position
        startPos = toggle.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if not dragging then return end

    if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart

        if math.abs(delta.X) > 6 or math.abs(delta.Y) > 6 then
            moved = true
        end

        if moved then
            local cam = workspace.CurrentCamera
            if cam then
                local view = cam.ViewportSize
                local x = math.clamp(
                    startPos.X.Offset + delta.X,
                    0,
                    view.X - toggle.AbsoluteSize.X
                )
                local y = math.clamp(
                    startPos.Y.Offset + delta.Y,
                    0,
                    view.Y - toggle.AbsoluteSize.Y
                )
                toggle.Position = UDim2.fromOffset(x, y)
            end
        end
    end
end)

UIS.InputEnded:Connect(function(input)
    if not dragging then return end

    if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false

        if not moved then
            hidden = not hidden
            root.Visible = not hidden
            toggle.Text = hidden and "▶" or "—"
        end

        dragStart = nil
        startPos = nil
    end
end)

-- =====================================================
-- MAIN UPDATE LOOP
-- =====================================================

RunService.RenderStepped:Connect(function(dt)
    if hidden or not root.Visible then return end

    -- FLAPPY UPDATE
    if currentGame == "flappy" and fAlive and fStarted then
        local cam = workspace.CurrentCamera
        if not cam then return end

        local v = cam.ViewportSize
        local groundY = v.Y - 42

        fVel += 1250 * dt
        fY += fVel * dt / v.Y
        bird.Position = UDim2.fromScale(0.25, fY)
        bird.Rotation = math.clamp(fVel / 15, -25, 80)

        local bx, by = v.X * 0.25, fY * v.Y
        local bw, bh = bird.AbsoluteSize.X, bird.AbsoluteSize.Y

        if by <= 0 or by + bh >= groundY then
            endFlappy()
        end

        fTimer += dt
        if fTimer >= math.max(0.75, 0.95 * v.X / fSpeed) then
            fTimer = 0
            spawnPipe()
        end

        for i = #fPipes, 1, -1 do
            local p = fPipes[i]
            p.x -= fSpeed * dt
            p.top.Position = UDim2.fromOffset(p.x, 0)
            p.cap1.Position = UDim2.fromOffset(p.x - 5, p.top.AbsoluteSize.Y - 22)
            p.bottom.Position = UDim2.fromOffset(p.x, p.center + p.gap / 2)
            p.cap2.Position = UDim2.fromOffset(p.x - 5, p.center + p.gap / 2)

            if bx + bw > p.x and bx < p.x + p.w then
                if by < p.center - p.gap / 2
                    or by + bh > p.center + p.gap / 2 then
                    endFlappy()
                end
            end

            if not p.scored and p.x + p.w < bx then
                p.scored = true
                fScore += 1
                fScoreLabel.Text = tostring(fScore)

                local stage = math.floor(fScore / 5) + 1
                if stage ~= fStage then
                    fStage = stage
                    fSpeed = 230 + (fStage - 1) * 25
                    fStageLabel.Text = "STAGE " .. fStage
                end
            end

            if p.x + p.w < -20 then
                p.top:Destroy()
                p.bottom:Destroy()
                p.cap1:Destroy()
                p.cap2:Destroy()
                table.remove(fPipes, i)
            end
        end

    elseif currentGame == "flappy" and fAlive and not fStarted then
        bird.Position = UDim2.fromScale(
            0.25, 0.45 + math.sin(os.clock() * 3) * 0.012
        )

    -- SNAKE UPDATE
    elseif currentGame == "snake" and sAlive then
        local cam = workspace.CurrentCamera
        if cam then
            local v = cam.ViewportSize
            local size = math.max(180, math.floor(math.min(v.X * 0.53, v.Y * 0.62)))
            board.Size = UDim2.fromOffset(size, size)
            sOver.Position = board.Position
        end

        sTimer += dt
        if sTimer >= sStep then
            sTimer -= sStep
            dir = {x = nextDir.x, y = nextDir.y}

            local head = snake[1]
            local newHead = {x = head.x + dir.x, y = head.y + dir.y}

            if newHead.x < 1 or newHead.x > GRID
                or newHead.y < 1 or newHead.y > GRID then
                sAlive = false
            else
                local eating = same(newHead, food)
                local limit = eating and #snake or (#snake - 1)

                for i = 1, limit do
                    if same(snake[i], newHead) then
                        sAlive = false
                        break
                    end
                end

                if sAlive then
                    table.insert(snake, 1, newHead)
                    if eating then
                        sScore += 1
                        sStep = math.max(0.075, 0.15 - sScore * 0.002)
                        placeFood()
                    else
                        table.remove(snake)
                    end
                end
            end

            if not sAlive then
                sFinal.Text = "Skor: " .. sScore
                sOver.Visible = true
            end

            renderSnake()
        end

    -- BRICK BREAKER UPDATE
    elseif currentGame == "brick" and bAlive then
        local size = playArea.AbsoluteSize
        if size.X <= 0 or size.Y <= 0 then return end

        paddleX = math.clamp(paddleX + paddleDir * dt * 0.8, 0.12, 0.88)
        paddle.Position = UDim2.new(paddleX, 0, 0.91, 0)

        if not ballStarted then
            ballX = paddleX
            ballY = 0.78
            ball.Position = UDim2.fromScale(ballX, ballY)
            return
        end

        local oldX, oldY = ballX, ballY
        ballX += ballVX * dt
        ballY += ballVY * dt

        local radiusX = 7 / size.X
        local radiusY = 7 / size.Y

        if ballX <= radiusX then
            ballX = radiusX
            ballVX = math.abs(ballVX)
        elseif ballX >= 1 - radiusX then
            ballX = 1 - radiusX
            ballVX = -math.abs(ballVX)
        end

        if ballY <= radiusY then
            ballY = radiusY
            ballVY = math.abs(ballVY)
        end

        -- Paddle collision
        local paddleY = 0.91
        if ballVY > 0
            and oldY + radiusY <= paddleY
            and ballY + radiusY >= paddleY - 0.025
            and math.abs(ballX - paddleX) < 0.14 then
            ballY = paddleY - 0.025
            ballVY = -math.abs(ballVY)
            ballVX = math.clamp((ballX - paddleX) * 2.5, -0.65, 0.65)
        end

        -- Brick collision
        for _, brick in ipairs(bricks) do
            if brick.alive and brick.frame.Parent then
                local bx = brick.frame.Position.X.Offset
                local by = brick.frame.Position.Y.Offset
                local bw = brick.frame.AbsoluteSize.X
                local bh = brick.frame.AbsoluteSize.Y

                local px = ballX * size.X
                local py = ballY * size.Y

                if px + 7 >= bx and px - 7 <= bx + bw
                    and py + 7 >= by and py - 7 <= by + bh then
                    brick.alive = false
                    brick.frame:Destroy()
                    bScore += 10
                    bScoreLabel.Text = "SKOR: " .. bScore
                    ballVY = -ballVY
                    break
                end
            end
        end

        if ballY > 1 then
            bLives -= 1
            bLivesLabel.Text = "NYAWA: " .. bLives

            if bLives <= 0 then
                finishBrick()
            else
                ballX, ballY = paddleX, 0.78
                ballVX, ballVY = 0.34, -0.48
                ballStarted = false
            end
        end

        ball.Position = UDim2.fromScale(ballX, ballY)

        local remaining = 0
        for _, brick in ipairs(bricks) do
            if brick.alive then remaining += 1 end
        end

        if remaining == 0 then
            finishBrick()
        end
    end
end)

