}
local function sfx(name,mul,vol)
 if not soundOn then return end
 local d=SFX[name]
 if not d then return end
 local s=Instance.new("Sound")
 s.SoundId=d[1]
 s.Volume=(vol or 1)*d[2]
 s.PlaybackSpeed=d[3]*(mul or 1)
 s.Parent=gui
 s:Play()
 Debris:AddItem(s,3)
end
local function seq(list)
 for _,n in ipairs(list) do
  task.delay(n[3] or 0,function() sfx(n[1],n[2]) end)
 end
end
local WINSEQ={{"ping",1,0},{"ping",1.26,.12},{"ping",1.5,.24},{"ping",2,.38}}

local function later(t,fn)
 local id=runId
 task.delay(t,function() if id==runId then fn() end end)
end

