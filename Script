games[11]=function()
 local N,GAP=8,3
 local EMPTY=Color3.fromRGB(46,52,104)
 local PALETTE={
  Color3.fromRGB(235,70,70),Color3.fromRGB(245,150,50),
  Color3.fromRGB(245,205,50),Color3.fromRGB(80,200,100),
  Color3.fromRGB(60,150,235),Color3.fromRGB(150,90,220),
  Color3.fromRGB(235,100,170),
 }
 local RAW={
  {"X"},
  {"XX"},{"X","X"},
  {"XXX"},{"X","X","X"},
  {"XXXX"},{"X","X","X","X"},
  {"XXXXX"},{"X","X","X","X","X"},
  {"XX","XX"},{"XXX","XXX","XXX"},
  {"XXX","XXX"},{"XX","XX","XX"},
  {"XX","X."},{"XX",".X"},{"X.","XX"},{".X","XX"},
  {"X..","X..","XXX"},{"..X","..X","XXX"},
  {"XXX","X..","X.."},{"XXX","..X","..X"},
  {"X.","X.","XX"},{".X",".X","XX"},
  {"XX","X.","X."},{"XX",".X",".X"},
  {"XXX",".X."},{".X.","XXX"},{"X.","XX","X."},{".X","XX",".X"},
  {".XX","XX."},{"XX.",".XX"},{"X.","XX",".X"},{".X","XX","X."},
 }
 local SHAPES={}
 for _,rows in ipairs(RAW) do
  local cl={}
  for r,row in ipairs(rows) do
   for c=1,#row do
    if row:sub(c,c)=="X" then table.insert(cl,{r-1,c-1}) end
   end
  end
  table.insert(SHAPES,{cells=cl,h=#rows,w=#rows[1]})
 end

 local myId=runId
 local function alive() return myId==runId end

 local grid={}
 for r=1,N do
  grid[r]={}
  for c=1,N do grid[r][c]=false end
 end
 local slots={}
 local score,combo=0,0
 local busy,isOver=false,false
 local drag=nil
 local cs,boardPx=20,0
 local slotW,slotH=80,80

 local root=obj("Frame",stage,{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,ZIndex=10})
 local board=obj("Frame",root,{BackgroundColor3=Color3.fromRGB(30,36,78),BorderSizePixel=0,ZIndex=11})
 round(board,10)
 stroke(board,C.line,2)
 local cells={}
 for r=1,N do
  cells[r]={}
  for c=1,N do
   local cell=obj("Frame",board,{BackgroundColor3=EMPTY,BorderSizePixel=0,ZIndex=12})
   round(cell,4)
   cells[r][c]=cell
  end
 end
 local slotFrames,trayPieces={}, {}

 local function buildPiece(piece,size,gap,z)
  local sh=piece.shape
  local fr=obj("Frame",nil,{
   BackgroundTransparency=1,ZIndex=z,
   Size=UDim2.fromOffset(sh.w*(size+gap)-gap,sh.h*(size+gap)-gap)
  })
  for _,cl in ipairs(sh.cells) do
   local c=obj("Frame",fr,{
    Size=UDim2.fromOffset(size,size),
    Position=UDim2.fromOffset(cl[2]*(size+gap),cl[1]*(size+gap)),
    BackgroundColor3=piece.color,BorderSizePixel=0,ZIndex=z
   })
   round(c,4)
  end
  return fr
 end

 local function canPlace(shape,row,col)
  for _,cl in ipairs(shape.cells) do
   local r,c=row+cl[1],col+cl[2]
   if r<1 or r>N or c<1 or c>N or grid[r][c] then return false end
  end
  return true
 end
 local function fitsAnywhere(shape)
  for r=1,N do for c=1,N do
   if canPlace(shape,r,c) then return true end
  end end
  return false
 end
 local function findLines(extra)
  local function filled(r,c) return grid[r][c] or (extra and extra[r*16+c]) end
  local rows,cols={}, {}
  for r=1,N do
   local full=true
   for c=1,N do if not filled(r,c) then full=false break end end
   if full then rows[#rows+1]=r end
  end
  for c=1,N do
   local full=true
   for r=1,N do if not filled(r,c) then full=false break end end
   if full then cols[#cols+1]=c end
  end
  return rows,cols
 end

 local function renderBoard(prev)
  local extra,hl=nil,{}
  if prev then
   extra={}
   for _,cl in ipairs(prev.piece.shape.cells) do
    extra[(prev.row+cl[1])*16+prev.col+cl[2]]=true
   end
   local rows,cols=findLines(extra)
   for _,r in ipairs(rows) do for c=1,N do hl[r*16+c]=true end end
   for _,c in ipairs(cols) do for r=1,N do hl[r*16+c]=true end end
  end
  for r=1,N do for c=1,N do
   local col=grid[r][c] or EMPTY
   if prev then
    local k=r*16+c
    if extra[k] then
     col=prev.piece.color
    elseif hl[k] and grid[r][c] then
     col=grid[r][c]:Lerp(C.white,.55)
    end
   end
   cells[r][c].BackgroundColor3=col
  end end
 end

 local function renderTray()
  for i=1,3 do
   if trayPieces[i] then trayPieces[i]:Destroy() trayPieces[i]=nil end
   local p=slots[i]
   if p and slotFrames[i] then
    local size=math.min(cs*.85,(slotW-16+2)/p.shape.w-2,(slotH-12+2)/p.shape.h-2)
    size=math.max(8,math.floor(size))
    local fr=buildPiece(p,size,2,13)
    fr.AnchorPoint=Vector2.new(.5,.5)
    fr.Position=UDim2.fromScale(.5,.5)
    fr.Parent=slotFrames[i]
    trayPieces[i]=fr
   end
  end
 end

 local function layout()
  local Wd,Hd=stage.AbsoluteSize.X,stage.AbsoluteSize.Y
  if Wd<50 or Hd<50 then return end
  local pad=6
  local bx,by
  if Wd>=Hd*1.15 then
   boardPx=math.min(Hd-pad*2,Wd*.5)
   cs=math.max(10,math.floor((boardPx-GAP*(N+1))/N))
   boardPx=cs*N+GAP*(N+1)
   local gap=18
   local trayW=math.min(280,Wd-boardPx-gap-pad*2)
   local groupW=boardPx+gap+trayW
   bx=(Wd-groupW)/2
   by=(Hd-boardPx)/2
   slotW=trayW
   slotH=(boardPx-16)/3
   for i=1,3 do
    slotFrames[i].Size=UDim2.fromOffset(slotW,slotH)
    slotFrames[i].Position=UDim2.fromOffset(bx+boardPx+gap,by+(i-1)*(slotH+8))
   end
  else
   boardPx=math.min(Wd-pad*2,Hd*.62)
   cs=math.max(10,math.floor((boardPx-GAP*(N+1))/N))
   boardPx=cs*N+GAP*(N+1)
   bx=(Wd-boardPx)/2
   by=pad
   slotW=(Wd-pad*2-16)/3
   slotH=math.max(40,Hd-by-boardPx-pad*2)
   for i=1,3 do
    slotFrames[i].Size=UDim2.fromOffset(slotW,slotH)
    slotFrames[i].Position=UDim2.fromOffset(pad+(i-1)*(slotW+8),by+boardPx+pad)
   end
  end
  board.Position=UDim2.fromOffset(bx,by)
  board.Size=UDim2.fromOffset(boardPx,boardPx)
  for r=1,N do for c=1,N do
   local cell=cells[r][c]
   cell.Size=UDim2.fromOffset(cs,cs)
   cell.Position=UDim2.fromOffset(GAP+(c-1)*(cs+GAP),GAP+(r-1)*(cs+GAP))
  end end
  renderTray()
 end

 for i=1,3 do
  local s=obj("TextButton",root,{
   Text="",AutoButtonColor=false,BackgroundColor3=Color3.fromRGB(38,44,90),
   BackgroundTransparency=.25,BorderSizePixel=0,ZIndex=12
  })
  round(s,12)
  stroke(s,C.line,1.5,.4)
  slotFrames[i]=s
 end

 local function newPieces()
  for _=1,30 do
   for i=1,3 do
    slots[i]={shape=SHAPES[math.random(#SHAPES)],color=PALETTE[math.random(#PALETTE)]}
   end
   for i=1,3 do
    if fitsAnywhere(slots[i].shape) then return end
   end
  end
 end

 local function checkGameOver()
  for i=1,3 do
   if slots[i] and fitsAnywhere(slots[i].shape) then return end
  end
  isOver=true
  sfx("lose")
  later(.5,function() finish("GAME OVER") end)
