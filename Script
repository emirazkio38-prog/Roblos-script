games[3]=function()
 local AR=1.45
 local WW=AR
 local f,L,R=field(AR)
 f.BackgroundColor3=Color3.fromRGB(14,20,40)
 local PW,PH,PY=.30,.034,.92
 local px=WW/2
 local paddle=obj("Frame",f,{BackgroundColor3=C.green,BorderSizePixel=0,ZIndex=16})
 round(paddle,6)
 local rad=.03
 local ball=obj("Frame",f,{BackgroundColor3=C.white,BorderSizePixel=0,ZIndex=17})
 round(ball,999)
 local bx,by,vx,vy=px,PY-rad,0,0
 local spd=.95
 local launched,launchT=false,1.2
 local lives,level,score=3,1,0
 local bricks={}
 local info=txt(f,"",UDim2.new(0,6,0,2),UDim2.new(1,-12,0,16),12,C.dim,Enum.TextXAlignment.Left)
 info.ZIndex=22
 local function updInfo() info.Text="VIDA "..lives.."   NIVEL "..level end
 local rowCols={C.red,C.orange,C.yellow,C.green,C.blue}

 local function buildBricks()
  for _,b in ipairs(bricks) do b.f:Destroy() end
  bricks={}
  local cols,rows=8,5
  local gap=.012
  local bw=(WW-.1-gap*(cols-1))/cols
  local bh=.062
  for rr=1,rows do for cc=1,cols do
   local x=.05+(cc-1)*(bw+gap)
   local y=.11+(rr-1)*(bh+gap)
   local fr=obj("Frame",f,{BackgroundColor3=rowCols[rr],BorderSizePixel=0,ZIndex=14})
   round(fr,4)
   put(fr,WW,x,y,bw,bh)
   obj("Frame",fr,{Size=UDim2.fromScale(1,.3),BackgroundColor3=C.white,BackgroundTransparency=.7,BorderSizePixel=0,ZIndex=15})
   table.insert(bricks,{f=fr,x=x,y=y,w=bw,h=bh,hp=(level>=2 and rr<=2) and 2 or 1,row=rr})
  end end
 end
 local function placeAll()
  put(paddle,WW,px-PW/2,PY,PW,PH)
  put(ball,WW,bx-rad,by-rad,rad*2,rad*2)
 end
 local function launch()
  if launched then return end
  launched=true
  local ang=math.rad(math.random(-25,25))
  vx=spd*math.sin(ang)
  vy=-spd*math.cos(ang)
  sfx("tap")
 end
 local function setSpeed()
  local m=math.sqrt(vx*vx+vy*vy)
  if m>0 then vx=vx/m*spd vy=vy/m*spd end
 end

 -- kontrol
 local dragging=false
 local function setPx(io)
  local rel=(io.Position.X-f.AbsolutePosition.X)/f.AbsoluteSize.X*WW
  px=math.clamp(rel,PW/2,WW-PW/2)
 end
 f.InputBegan:Connect(function(io)
  if isPointer(io) then dragging=true setPx(io) launch() end
 end)
 f.InputChanged:Connect(function(io)
  if dragging and (io.UserInputType==Enum.UserInputType.Touch or io.UserInputType==Enum.UserInputType.MouseMovement) then setPx(io) end
 end)
 f.InputEnded:Connect(function(io) if isPointer(io) then dragging=false end end)
 holdBtn(L,"left",UDim2.new(0,0,.5,-40),UDim2.new(1,0,0,80),C.yellow,"left")
 holdBtn(R,"right",UDim2.new(0,0,.5,-40),UDim2.new(1,0,0,80),C.yellow,"right")
 keyTap[Enum.KeyCode.Space]=launch

 buildBricks()
 updInfo()
 placeAll()

 update=function(dt)
  local mv=(held.right and 1 or 0)-(held.left and 1 or 0)
  if mv~=0 then px=math.clamp(px+mv*1.5*dt,PW/2,WW-PW/2) end
  if not launched then
   bx=px
   by=PY-rad-.002
   launchT-=dt
   if launchT<=0 then launch() end
   placeAll()
   return
  end
  local sp=math.sqrt(vx*vx+vy*vy)
  local n=math.max(1,math.ceil(sp*dt/.012))
  local sdt=dt/n
  for _=1,n do
   bx+=vx*sdt
   by+=vy*sdt
   if bx<rad then bx=rad vx=math.abs(vx) sfx("tap",.8) end
   if bx>WW-rad then bx=WW-rad vx=-math.abs(vx) sfx("tap",.8) end
   if by<rad then by=rad vy=math.abs(vy) sfx("tap",.8) end
   -- paddle
   if vy>0 and by+rad>=PY and by-rad<=PY+PH and bx>=px-PW/2-rad and bx<=px+PW/2+rad then
    local off=math.clamp((bx-px)/(PW/2),-1,1)
    local ang=off*math.rad(60)
    vx=spd*math.sin(ang)
    vy=-spd*math.cos(ang)
    by=PY-rad
    sfx("hit")
   end
   -- bricks
   for i=#bricks,1,-1 do
    local b=bricks[i]
    local cx=math.clamp(bx,b.x,b.x+b.w)
    local cy=math.clamp(by,b.y,b.y+b.h)
    local dx,dy=bx-cx,by-cy
    if dx*dx+dy*dy<rad*rad then
     if math.abs(dx)>math.abs(dy) then
      vx=(dx>0) and math.abs(vx) or -math.abs(vx)
     else
      vy=(dy>0) and math.abs(vy) or -math.abs(vy)
     end
     b.hp-=1
     if b.hp<=0 then
      burst(f,UDim2.fromScale((b.x+b.w/2)/WW,b.y+b.h/2),rowCols[b.row],8,22)
      b.f:Destroy()
      table.remove(bricks,i)
      score+=10*level
      setScore(score)
      sfx("pop",1+(5-b.row)*.08)
     else
      b.f.BackgroundColor3=rowCols[b.row]:Lerp(C.dark,.45)
      sfx("hit",1.3)
     end
     spd=math.min(spd+.012,1.7)
     setSpeed()
     break
    end
   end
   if by>1+rad then
    lives-=1
    sfx("lose")
    updInfo()
    if lives<=0 then
     finish("GAME OVER")
     return
    end
    launched=false
    launchT=1.2
    vx,vy=0,0
    break
   end
  end
  if #bricks==0 then
   level+=1
   spd+=.08
   seq(WINSEQ)
   popText(f,UDim2.fromScale(.5,.5),"NIVEL "..level,C.yellow,26)
   buildBricks()
   launched=false
   launchT=1.4
   vx,vy=0,0
   updInfo()
  end
  placeAll()
 end
end

