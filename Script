local keyHold={
 [Enum.KeyCode.W]="up",[Enum.KeyCode.Up]="up",
 [Enum.KeyCode.S]="down",[Enum.KeyCode.Down]="down",
 [Enum.KeyCode.A]="left",[Enum.KeyCode.Left]="left",
 [Enum.KeyCode.D]="right",[Enum.KeyCode.Right]="right",
 [Enum.KeyCode.Space]="fire",
}
local keyBound=false
local function keyAction(_,state,io)
 local h=keyHold[io.KeyCode]
 if h then held[h]=(state==Enum.UserInputState.Begin) end
 if state==Enum.UserInputState.Begin then
  local fn=keyTap[io.KeyCode]
  if fn then fn() end
 end
 return Enum.ContextActionResult.Sink
end
local function bindKeys()
 if keyBound then return end
 keyBound=true
 CAS:BindActionAtPriority("ArcadeKeys",keyAction,false,Enum.ContextActionPriority.High.Value,
  Enum.KeyCode.W,Enum.KeyCode.A,Enum.KeyCode.S,Enum.KeyCode.D,
  Enum.KeyCode.Up,Enum.KeyCode.Down,Enum.KeyCode.Left,Enum.KeyCode.Right,Enum.KeyCode.Space)
end
local function unbindKeys()
 if not keyBound then return end
 keyBound=false
 CAS:UnbindAction("ArcadeKeys")
 for k in pairs(held) do held[k]=false end
end

