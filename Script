local function spawnPipe()
    local cam = workspace.CurrentCamera
    if not cam then return end
    local v = cam.ViewportSize
    local groundY = v.Y - 42
    local gap = math.max(125, 175 - (fStage - 1) * 5)
    local minY = 100 + gap / 2
    local maxY = math.max(minY, groundY - 70 - gap / 2)
    local center = math.random(math.floor(minY), math.floor(maxY))
    local w = math.clamp(v.X * 0.15, 55, 76)
    local x = v.X + w
    local topH = center - gap / 2
    local botY = center + gap / 2

    local top = make("Frame", "PipeTop", flappy, {
        Position = UDim2.fromOffset(x, 0),
        Size = UDim2.fromOffset(w, topH),
        BackgroundColor3 = Color3.fromRGB(55, 190, 65),
        BorderSizePixel = 0,
        ZIndex = 4
    })
    local cap1 = make("Frame", "PipeCapTop", flappy, {
        Position = UDim2.fromOffset(x - 5, topH - 22),
        Size = UDim2.fromOffset(w + 10, 22),
        BackgroundColor3 = Color3.fromRGB(65, 210, 70),
        BorderSizePixel = 0,
        ZIndex = 5
    })
    local bottom = make("Frame", "PipeBottom", flappy, {
        Position = UDim2.fromOffset(x, botY),
        Size = UDim2.fromOffset(w, groundY - botY),
        BackgroundColor3 = Color3.fromRGB(55, 190, 65),
        BorderSizePixel = 0,
        ZIndex = 4
    })
    local cap2 = make("Frame", "PipeCapBottom", flappy, {
        Position = UDim2.fromOffset(x - 5, botY),
        Size = UDim2.fromOffset(w + 10, 22),
        BackgroundColor3 = Color3.fromRGB(65, 210, 70),
        BorderSizePixel = 0,
        ZIndex = 5
    })
    for _, obj in ipairs({top, cap1, bottom, cap2}) do
        stroke(obj, Color3.fromRGB(25, 120, 40), 2)
    end
    table.insert(fPipes, {
        x = x, w = w, gap = gap, center = center,
        scored = false, top = top, cap1 = cap1,
        bottom = bottom, cap2 = cap2
    })
end

