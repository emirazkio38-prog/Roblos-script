    popText(f,UDim2.fromScale(p.x/WW,p.y),"TRIPLE!",C.cyan,16)
    p.f:Destroy()
    table.remove(pickups,i)
    updInfo()
   elseif p.x<-.1 then
    p.f:Destroy()
    table.remove(pickups,i)
   end
  end
 end
end

