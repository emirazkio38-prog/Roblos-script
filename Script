 -- drag & drop
 local function toScreen(io)
  return Vector2.new(io.Position.X,io.Position.Y)+GuiService:GetGuiInset()
 end
 local function moveDrag(pos)
  local p=drag.piece
  local sh=p.shape
  local pw=sh.w*(cs+GAP)-GAP
  local ph=sh.h*(cs+GAP)-GAP
  local lift=0
  if drag.touch then
   lift=math.clamp((gui.AbsoluteSize.Y-pos.Y)/2,0,cs*2)
  end
  local tlx,tly=pos.X-pw/2,pos.Y-ph/2-lift
  drag.frame.Position=UDim2.fromOffset(tlx,tly)
  drag.pos=pos
  local bp=board.AbsolutePosition
  local fc=(tlx-bp.X-GAP)/(cs+GAP)+1
  local fr=(tly-bp.Y-GAP)/(cs+GAP)+1
  local c0,r0=math.floor(fc+.5),math.floor(fr+.5)
  local bestD,bestR,bestC=1.6,nil,nil
  for dr=-1,1 do for dc=-1,1 do
   local r,c=r0+dr,c0+dc
   local dist=(fr-r)^2+(fc-c)^2
   if dist<bestD and canPlace(sh,r,c) then bestD,bestR,bestC=dist,r,c end
  end end
  local key
  if bestR then
   key=bestR..","..bestC
   drag.target={bestR,bestC}
  else
   drag.target=nil
  end
  if key~=drag.key then
   drag.key=key
   if drag.target then renderBoard({piece=p,row=bestR,col=bestC}) else renderBoard() end
  end
 end
 local function startDrag(i,io)
  if drag or busy or isOver or finished then return end
  local ty=io.UserInputType
  if ty~=Enum.UserInputType.Touch and ty~=Enum.UserInputType.MouseButton1 then return end
  local p=slots[i]
  if not p then return end
  sfx("pop",1.3)
  local fr=buildPiece(p,cs,GAP,60)
  fr.Parent=gui
  drag={slot=i,piece=p,frame=fr,input=io,touch=(ty==Enum.UserInputType.Touch)}
  if trayPieces[i] then trayPieces[i].Visible=false end
  moveDrag(toScreen(io))
 end
 local function endDrag()
  local d=drag
  drag=nil
  d.frame:Destroy()
  renderBoard()
  if d.target then
   task.spawn(place,d.slot,d.target[1],d.target[2])
  else
   if trayPieces[d.slot] then trayPieces[d.slot].Visible=true end
   local p=d.pos
   if p then
    local bp,bs=board.AbsolutePosition,board.AbsoluteSize
    if p.X>bp.X and p.X<bp.X+bs.X and p.Y>bp.Y and p.Y<bp.Y+bs.Y then sfx("bad") end
   end
  end
 end
 table.insert(connections,UIS.InputChanged:Connect(function(io)
  if not drag then return end
  if drag.touch then
   if io==drag.input then moveDrag(toScreen(io)) end
  elseif io.UserInputType==Enum.UserInputType.MouseMovement then
   moveDrag(toScreen(io))
  end
 end))
 table.insert(connections,UIS.InputEnded:Connect(function(io)
  if not drag then return end
  if drag.touch then
   if io==drag.input then endDrag() end
  elseif io.UserInputType==Enum.UserInputType.MouseButton1 then
   endDrag()
  end
 end))
 for i=1,3 do
  slotFrames[i].InputBegan:Connect(function(io) startDrag(i,io) end)
 end

 clean=function()
  if drag then
   drag.frame:Destroy()
   drag=nil
  end
 end

 table.insert(connections,stage:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
  layout()
  renderBoard()
 end))
