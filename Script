local function refreshMenu()
 for i=1,#names do bestLbls[i].Text="TERBAIK "..(bests[i] or 0) end
end

showMenu=function()
 clear()
 runId+=1
 area.Visible=false
 menu.Visible=true
 unbindKeys()
 refreshMenu()
end

start=function(i)
 clear()
 runId+=1
 finished=false
 curIndex=i
 hudName.Text=names[i]
 menu.Visible=false
 area.Visible=true
 setScore(0)
 if panel.Visible then bindKeys() end
 local ok,err=pcall(games[i])
 if not ok then
  warn("Pixel Arcade error:",err)
  clear()
  txt(stage,"GAME ERROR\n"..tostring(err):sub(1,90),UDim2.new(.1,0,.3,0),UDim2.new(.8,0,.4,0),14,C.red)
 end
end

local hb=RunService.Heartbeat:Connect(function(dt)
 if update and panel.Visible and area.Visible then
  local ok,err=pcall(update,math.min(dt,.05))
  if not ok then
   warn("Pixel Arcade update error:",err)
   update=nil
  end
 end
end)

gui.Destroying:Connect(function()
 hb:Disconnect()
 unbindKeys()
 pcall(clear)
end)

refreshMenu()
