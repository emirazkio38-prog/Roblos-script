local function burst(parent,pos,color,n,spread)
 for _=1,n do
  local p=obj("Frame",parent,{
   Size=UDim2.fromOffset(5,5),Position=pos,AnchorPoint=Vector2.new(.5,.5),
   BackgroundColor3=color,BorderSizePixel=0,ZIndex=60
  })
  local a=math.random()*math.pi*2
  local d=(spread or 28)*(.4+math.random()*.8)
  TweenService:Create(p,TweenInfo.new(.4+math.random()*.25,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{
   Position=pos+UDim2.fromOffset(math.cos(a)*d,math.sin(a)*d),BackgroundTransparency=1
  }):Play()
  Debris:AddItem(p,.8)
 end
end

