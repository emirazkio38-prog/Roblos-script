-- Move paddle with touch/mouse. Tap area to launch ball.
local function movePaddleFromScreenX(screenX)
    local areaPos = playArea.AbsolutePosition
    local areaSize = playArea.AbsoluteSize
    if areaSize.X <= 0 then return end
    paddleX = math.clamp((screenX - areaPos.X) / areaSize.X, 0.12, 0.88)
    paddle.Position = UDim2.new(paddleX, 0, 0.91, 0)
end

playArea.InputBegan:Connect(function(input)
    if currentGame ~= "brick" or hidden or not bAlive then return end

    if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
        movePaddleFromScreenX(input.Position.X)
        ballStarted = true
    end
end)

UIS.InputChanged:Connect(function(input)
    if currentGame ~= "brick" or hidden then return end

    if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseMovement then
        if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
            or input.UserInputType == Enum.UserInputType.Touch then
            movePaddleFromScreenX(input.Position.X)
        end
    end
end)

-- Keyboard paddle control for computer
UIS.InputBegan:Connect(function(input, processed)
    if processed or hidden then return end
    if currentGame == "brick" then
        if input.KeyCode == Enum.KeyCode.Left then paddleDir = -1 end
        if input.KeyCode == Enum.KeyCode.Right then paddleDir = 1 end
        if input.KeyCode == Enum.KeyCode.Space then ballStarted = true end
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.Left and paddleDir == -1 then paddleDir = 0 end
    if input.KeyCode == Enum.KeyCode.Right and paddleDir == 1 then paddleDir = 0 end
end)

