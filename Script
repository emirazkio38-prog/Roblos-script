 f.InputEnded:Connect(function(io) if isPointer(io) then drag=false end end)
 holdBtn(L,"up",UDim2.new(0,0,.5,-76),UDim2.new(1,0,0,70),C.yellow,"up")
 holdBtn(L,"down",UDim2.new(0,0,.5,6),UDim2.new(1,0,0,70),C.yellow,"down")
 holdBtn(R,"fire",UDim2.new(0,0,.5,-50),UDim2.new(1,0,0,100),C.red,nil,"FIRE")
 updInfo()

 update=function(dt)
  for _,s in ipairs(stars) do
   s.x-=s.v*dt
   if s.x<0 then s.x=WW s.y=math.random() end
   s.f.Position=UDim2.fromScale(s.x/WW,s.y)
  end
  if dead then return end
  local dy=(held.down and 1 or 0)-(held.up and 1 or 0)
  if dy~=0 then sy=math.clamp(sy+dy*.9*dt,.08,.92) end
  put(ship,WW,sx,sy-sh/2,sw,sh)
  if inv>0 then
   inv-=dt
   ship.Visible=(math.floor(inv*10)%2==0)
   if inv<=0 then ship.Visible=true end
  end
  if powerT>0 then powerT-=dt updInfo() end
  fireT-=dt
  if held.fire then fire() end

  spawnT-=dt
  if spawnT<=0 then
   spawn()
   spawnT=math.max(.4,1.0-score*.002)*(.7+math.random()*.6)
  end

  -- peluru
  for i=#bullets,1,-1 do
   local b=bullets[i]
   b.x+=2.2*dt
   b.y+=b.vy*dt
   put(b.f,WW,b.x,b.y-.007,.05,.014)
   if b.x>WW+.1 or b.y<0 or b.y>1 then b.f:Destroy() table.remove(bullets,i) end
  end
  -- musuh
  for i=#enemies,1,-1 do
   local e=enemies[i]
   e.x-=e.v*dt
   e.t+=dt
   e.y=math.clamp(e.y0+math.sin(e.t*2)*e.amp,0,1-e.h)
   put(e.f,WW,e.x,e.y,e.w,e.h)
   local removed=false
