       round(pf,999)
       table.insert(pickups,{f=pf,x=e.x,y=e.y+e.h/2})
      end
      e.f:Destroy()
      table.remove(enemies,i)
      removed=true
     else
      sfx("hit",1.5)
     end
     break
    end
   end
   if not removed then
    if inv<=0 and rect(sx+.02,sy-sh/2+.02,sw-.04,sh-.04,e.x+.01,e.y+.01,e.w-.02,e.h-.02) then
     burst(f,UDim2.fromScale((e.x+e.w/2)/WW,e.y+e.h/2),C.orange,10,26)
