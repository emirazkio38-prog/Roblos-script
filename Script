 local function place(i,row,col)
  busy=true
  local p=slots[i]
  sfx("place")
  for _,cl in ipairs(p.shape.cells) do
   grid[row+cl[1]][col+cl[2]]=p.color
  end
  slots[i]=nil
  score+=#p.shape.cells
  renderBoard()
  renderTray()

  local rows,cols=findLines()
  local n=#rows+#cols
  if n>0 then
   combo+=1
   local clr={}
   for _,r in ipairs(rows) do for c=1,N do clr[r*16+c]=true end end
   for _,c in ipairs(cols) do for r=1,N do clr[r*16+c]=true end end
   for k in pairs(clr) do cells[k//16][k%16].BackgroundColor3=C.white end
   local beeps=math.min(n+combo-1,6)
   for b=1,beeps do
    task.delay((b-1)*.07,function() sfx("ping",1+.12*(b-1)) end)
   end
   task.wait(.15)
   if not alive() then return end
   for k in pairs(clr) do
    local rr,cc=k//16,k%16
    burst(root,UDim2.fromOffset(board.Position.X.Offset+GAP+(cc-1)*(cs+GAP)+cs/2,board.Position.Y.Offset+GAP+(rr-1)*(cs+GAP)+cs/2),grid[rr][cc] or C.white,3,18)
    grid[rr][cc]=false
   end
   local gain=n*n*10+(combo-1)*10
   score+=gain
   local empty=true
   for r=1,N do for c=1,N do if grid[r][c] then empty=false end end end
   if empty then
    score+=300
    gain+=300
    seq(WINSEQ)
   end
   local msg=""
   if n>=2 then msg=n.." GARIS! " end
   msg=msg.."+"..gain
   if combo>1 then msg=msg.."  COMBO x"..combo end
   if empty then msg="PERFECT! "..msg end
   popText(root,UDim2.new(0,board.Position.X.Offset+boardPx/2,0,board.Position.Y.Offset+boardPx/2),msg,C.yellow,20)
  else
   combo=0
  end

  renderBoard()
  setScore(score)
  if not (slots[1] or slots[2] or slots[3]) then newPieces() end
  renderTray()
  busy=false
  checkGameOver()
