games[2]=function()
 local COLS,ROWS=16,11
 local f,L,R=field(COLS/ROWS)
 local cells={}
 for x=1,COLS do
  cells[x]={}
  for y=1,ROWS do
   cells[x][y]=obj("Frame",f,{
    Position=UDim2.new((x-1)/COLS,1,(y-1)/ROWS,1),
    Size=UDim2.new(1/COLS,-2,1/ROWS,-2),BorderSizePixel=0,ZIndex=11
   })
  end
 end
 local body={{x=8,y=6},{x=7,y=6},{x=6,y=6}}
 local dir={x=1,y=0}
 local dirQ={}
 local food
 local score,acc=0,0
 local dead=false
 local base1,base2=Color3.fromRGB(26,40,56),Color3.fromRGB(31,47,66)

 local function spawnFood()
  local free={}
  local used={}
  for _,v in ipairs(body) do used[v.x*100+v.y]=true end
  for x=1,COLS do for y=1,ROWS do
   if not used[x*100+y] then table.insert(free,{x=x,y=y}) end
  end end
  if #free==0 then return false end
  food=free[math.random(#free)]
  return true
 end
 local function draw()
  for x=1,COLS do for y=1,ROWS do
   cells[x][y].BackgroundColor3=((x+y)%2==0) and base1 or base2
  end end
  if food then cells[food.x][food.y].BackgroundColor3=C.red end
  for i,v in ipairs(body) do
   if i==1 then
    cells[v.x][v.y].BackgroundColor3=Color3.fromRGB(130,255,170)
   else
    cells[v.x][v.y].BackgroundColor3=Color3.fromRGB(60,205,115):Lerp(Color3.fromRGB(30,115,80),i/#body)
   end
  end
 end
 local function turn(x,y)
  local last=dirQ[#dirQ] or dir
  if (x==-last.x and y==-last.y) or (x==last.x and y==last.y) then return end
  if #dirQ<2 then
   table.insert(dirQ,{x=x,y=y})
   sfx("tap")
  end
 end
 local function die()
  if dead then return end
  dead=true
  sfx("lose")
  local h=body[1]
  burst(f,UDim2.fromScale((h.x-.5)/COLS,(h.y-.5)/ROWS),C.green,14,30)
  later(.7,function() finish("GAME OVER") end)
 end

 -- D-pad
 local dp=obj("Frame",L,{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.fromOffset(148,148),BackgroundTransparency=1,ZIndex=21})
 local function db(dir2,px,py,fn)
  local b=btn(dp,"",UDim2.fromOffset(px,py),UDim2.fromOffset(48,48),C.yellow,fn,16)
  arrow(b,dir2,C.dark)
 end
 db("up",50,0,function() turn(0,-1) end)
 db("left",0,50,function() turn(-1,0) end)
 db("right",100,50,function() turn(1,0) end)
 db("down",50,100,function() turn(0,1) end)
 hint(R,"Geser jari di layar atau pakai tombol arah",70)

 keyTap[Enum.KeyCode.W]=function() turn(0,-1) end
 keyTap[Enum.KeyCode.Up]=function() turn(0,-1) end
 keyTap[Enum.KeyCode.S]=function() turn(0,1) end
 keyTap[Enum.KeyCode.Down]=function() turn(0,1) end
 keyTap[Enum.KeyCode.A]=function() turn(-1,0) end
 keyTap[Enum.KeyCode.Left]=function() turn(-1,0) end
 keyTap[Enum.KeyCode.D]=function() turn(1,0) end
 keyTap[Enum.KeyCode.Right]=function() turn(1,0) end

 -- geser (swipe)
 local sx,sy,sid
 f.InputBegan:Connect(function(io)
  if isPointer(io) then sx,sy,sid=io.Position.X,io.Position.Y,io end
 end)
 f.InputChanged:Connect(function(io)
  if sid and (io==sid or io.UserInputType==Enum.UserInputType.MouseMovement) then
   local dx,dy=io.Position.X-sx,io.Position.Y-sy
   if math.abs(dx)>24 or math.abs(dy)>24 then
    if math.abs(dx)>math.abs(dy) then turn(dx>0 and 1 or -1,0) else turn(0,dy>0 and 1 or -1) end
    sx,sy=io.Position.X,io.Position.Y
   end
  end
 end)
 f.InputEnded:Connect(function(io) if io==sid then sid=nil end end)

 spawnFood()
 draw()
 update=function(dt)
  if dead then return end
  acc+=dt
  local step=math.max(.085,.17-score*.0035)
  if acc<step then return end
  acc-=step
  if #dirQ>0 then dir=table.remove(dirQ,1) end
  local h=body[1]
  local nx,ny=h.x+dir.x,h.y+dir.y
  if nx<1 or nx>COLS or ny<1 or ny>ROWS then die() return end
  local eating=food and nx==food.x and ny==food.y
  for i,v in ipairs(body) do
   if not (i==#body and not eating) and v.x==nx and v.y==ny then die() return end
  end
  table.insert(body,1,{x=nx,y=ny})
  if eating then
   score+=1
   setScore(score)
   sfx("coin")
   burst(f,UDim2.fromScale((nx-.5)/COLS,(ny-.5)/ROWS),C.red,8,20)
   if not spawnFood() then
    dead=true
    draw()
    finish("MENANG!",true)
    return
   end
  else
   table.remove(body)
  end
  draw()
 end
end

